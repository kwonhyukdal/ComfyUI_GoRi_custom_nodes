#!/bin/sh
# Commit gate.
#
# Rule 1: any .py change requires WORK_STATUS.md, which travels with the commit.
# Rule 2: a keeper change requires Keeper_Logic.md to be at least as new as the
#         code. That doc is a personal reference and is gitignored, so it is
#         checked by modification time rather than by staging.
#
# Why this exists (2026-10-01): working one long session kept producing
# confident wrong conclusions - denoise, the switch and the sheet verdict were
# each settled by guessing first and measuring later. WORK_STATUS.md exists to
# stop that, but a doc nobody is forced to touch goes stale, and a stale doc
# is worse than none because it reads as authoritative.
#
# Pure ASCII on purpose: git runs this under sh, and a hook carrying UTF-8 can
# be mis-split by a non-UTF-8 console the same way a .bat can.
#
# Bypass deliberately:  git commit --no-verify
# A blocked commit is a prompt to write down what changed, not a wall.

STATUS_DOC="WORK_STATUS.md"
# Each logic doc is personal and gitignored, so it is checked by modification time
# rather than by staging, and it only guards the folder it documents.
# Doc naming follows the rule: <development target name>_Logic.md
LOGIC_DOC="Keeper_Logic.md"
LOGIC_DIR="Comfyui-GoRi-Consistency-Keeper"
CAMERA_LOGIC_DOC="camera_Logic.md"
HARNESS_LOGIC_DOC="Harness_Logic.md"
# Why the odd casing: git matches pathspecs case-sensitively even on Windows, and
# a wrong-case directory silently matches nothing - the rule then never fires and
# reports success. Both directory names below are copied from `git ls-files`.
CAMERA_DIR="ComfyUI-GoRi-camera-director"
HARNESS_DIR="tools"

staged="$(git diff --cached --name-only)"
[ -z "$staged" ] && exit 0

# Rule 1.
if ! echo "$staged" | grep -qx "$STATUS_DOC"; then
  if echo "$staged" | grep -q '\.py$'; then
    {
      echo ""
      echo "BLOCKED: a .py file is staged but $STATUS_DOC is not."
      echo ""
      echo "Staged:"
      echo "$staged" | sed 's/^/  /'
      echo ""
      echo "Update $STATUS_DOC with what changed and why, then stage it:"
      echo "  git add $STATUS_DOC"
      echo ""
      echo "If this change genuinely needs no doc update, bypass on purpose:"
      echo "  git commit --no-verify"
      echo ""
    } >&2
    exit 1
  fi
fi

# Rule 2. If a doc does not exist - fresh clone, or someone who does not keep it
# - the rule does not apply. A gate that fires for everyone over a file nobody has
# is a gate people learn to bypass.
check_freshness() {
  _doc="$1"
  _dir="$2"
  [ -f "$_doc" ] || return 0
  for _f in $(echo "$staged" | grep "^$_dir/.*\.py$"); do
    if [ "$_f" -nt "$_doc" ]; then
      {
        echo ""
        echo "BLOCKED: code is newer than $_doc."
        echo ""
        echo "  $_f   (edited after the doc)"
        echo "  $_doc"
        echo ""
        echo "$_doc documents every function, constant and decision in this"
        echo "folder. A code change that does not update it leaves the document"
        echo "describing code that no longer exists."
        echo ""
        echo "Read it, update it, then mark it newer than the code:"
        echo "  touch $_doc"
        echo ""
        echo "If this change genuinely needs no doc update, bypass on purpose:"
        echo "  git commit --no-verify"
        echo ""
      } >&2
      return 1
    fi
  done
  return 0
}

check_freshness "$LOGIC_DOC" "$LOGIC_DIR" || exit 1
check_freshness "$CAMERA_LOGIC_DOC" "$CAMERA_DIR" || exit 1
check_freshness "$HARNESS_LOGIC_DOC" "$HARNESS_DIR" || exit 1

exit 0